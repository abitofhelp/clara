with "../../clara.gpr";

project Integration_Tests is

   for Source_Dirs use (".", "../common");
   for Object_Dir use "../obj/integration";
   for Exec_Dir use "../bin";
   for Create_Missing_Dirs use "True";

   for Main use ("integration_runner.adb");

   package Compiler renames Clara.Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Switches ("Ada") use ("-g");
   end Builder;

end Integration_Tests;
